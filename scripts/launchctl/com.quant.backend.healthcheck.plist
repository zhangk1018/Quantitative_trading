<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.quant.backend.healthcheck</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Volumes/MyData/Quantitative_trading/scripts/cron_backend_health.sh</string>
    </array>

    <!-- 每分钟执行一次 -->
    <key>StartInterval</key>
    <integer>60</integer>

    <!-- 标准输出/错误重定向到日志 -->
    <key>StandardOutPath</key>
    <string>/Volumes/MyData/Quantitative_trading/logs/quant_backend.healthcheck.log</string>
    <key>StandardErrorPath</key>
    <string>/Volumes/MyData/Quantitative_trading/logs/quant_backend.healthcheck.err.log</string>

    <!-- 标准 I/O 环境 -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- 不 KeepAlive（定时执行，不是常驻） -->
    <key>KeepAlive</key>
    <false/>

    <!-- 运行后立即退出，不等超时 -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>