<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.quant.bar-aggregation.overseas.weekly.us</string>

    <!-- 美股周线聚合（协作单 58.0，自 2026-10-17 拆出为独立任务）：按 .IXIC 日历划分 ISO 周。
         触发时点：周六 09:30（美股 T 日数据 T+1 08:30 落库，留约 60min 余量）。
         结算判据（compute_bar_aggregation._bucket_settleable，market=us）：该 ISO 周**周六已到**
         （美股周末休市；且周五数据 T+1 周六 08:30 才落库，故以周六为结算点）。
         看板侧（monitor._expected_period_label）：美股按当地日期（北京 -12h）推算，结算点等价于
         北京周六 12:00 —— 晚于本任务，故不存在「结算已到但任务未跑」的假 pending。
         caffeinate 包裹：任务运行期间阻止系统休眠（2026-10-01 美股事故约定）。 -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/caffeinate</string>
        <string>-i</string>
        <string>-s</string>
        <string>--</string>
        <string>/Volumes/MyData/Quantitative_trading/venv/bin/python</string>
        <string>/Volumes/MyData/Quantitative_trading/backend/collector/etl/compute_bar_aggregation.py</string>
        <string>--cycle</string>
        <string>1w</string>
        <string>--market</string>
        <string>us</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Volumes/MyData/Quantitative_trading</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/Volumes/MyData/Quantitative_trading/venv/bin</string>
        <key>PYTHONPATH</key>
        <string>/Volumes/MyData/Quantitative_trading/backend</string>
        <key>APP_ENV</key>
        <string>dev</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Volumes/MyData/Quantitative_trading/logs/cron/overseas_weekly_aggregation_us.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Volumes/MyData/Quantitative_trading/logs/cron/overseas_weekly_aggregation_us.stderr.log</string>

    <!-- Weekday: 6=周六 09:30 -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Weekday</key><integer>6</integer>
            <key>Hour</key><integer>9</integer>
            <key>Minute</key><integer>30</integer>
        </dict>
    </array>

    <key>ThrottleInterval</key>
    <integer>0</integer>
    <key>NumberOfRetries</key>
    <integer>0</integer>
</dict>
</plist>
